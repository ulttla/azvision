# Backend
AZVISION_ENV=development
# Keep production-like defaults safe. Set AZVISION_DEBUG=true only for local troubleshooting.
AZVISION_DEBUG=false
AZVISION_API_V1_PREFIX=/api/v1
AZVISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174,http://localhost:4175,http://127.0.0.1:4175,http://localhost:4176,http://127.0.0.1:4176
# Comma-separated hosts allowed by production host validation. Use a concrete domain for hosted deployments.
# Local development may keep *, but hosted environments should set an explicit domain.
AZVISION_ALLOWED_HOSTS=*
AZVISION_DATABASE_URL=sqlite:///./azvision.db

# Azure (Phase 1A live read wiring)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CERT_PATH=
AZURE_CERT_THUMBPRINT=
AZURE_CERT_PASSWORD=
AZURE_CLOUD=public

# Read-only Copilot provider MVP
# Rule-based fallback works without external provider config.
COPILOT_ENABLED=false
COPILOT_DEFAULT_PROVIDER=rule-based
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Optional non-secret app attribution headers for OpenRouter hosted-provider requests.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AzVision
# Keep OPENROUTER_API_KEY in local backend env only; never expose it to frontend code or chat.
# OPENROUTER_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_TOPOLOGY_SNAPSHOT_BACKEND=local
